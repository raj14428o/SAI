# Gmail SMTP Configuration (for sending emails)
GMAIL_MAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Gemini AI API Key (for intelligent voice email content drafting & open-ended conversation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Gemini 3.8 Flash)
GEMINI_MODEL=gemini-3.8-flash
